---
import Text from './fundations/elements/Text.astro';
import Button from './fundations/elements/Button.astro';
import Wrapper from './fundations/containers/Wrapper.astro';
import Grid from './fundations/containers/Grid.astro';

const MESSAGES: Record<string, string> = {
  subscribed: 'Thanks! You’re on the list.',
  confirm: 'Almost done! Check your inbox to confirm.',
  already: 'You’re already on the list. Thank you!',
  invalid: 'Please enter a valid email address.',
  error: 'Something went wrong. Please try again.',
};
// Set when the form was submitted without JavaScript and redirected back here.
const status = Astro.url.searchParams.get('newsletter') ?? '';
const message = MESSAGES[status];
---

<section id="newsletter" aria-labelledby="newsletter-title">
  <Wrapper variant="standard" class="py-24">
    <Grid class="p-8 gap-y-8 rounded-xl bg-muted lg:p-12">
      <div class="flex flex-col col-span-12 gap-4 lg:col-span-6">
        <Text id="newsletter-title" tag="h2" variant="displaySM" class="tracking-tight text-foreground font-medium">
          Stay in the loop
        </Text>
        <Text tag="p" variant="textBase" class="max-w-md text-muted-foreground text-pretty">
          Be the first to know about new flavors, markets, and all things Jamn Good.
        </Text>
      </div>
      <div class="flex flex-col col-span-12 gap-3 lg:col-span-6 lg:justify-center">
        <form class="flex flex-col gap-3 sm:flex-row" action="/api/subscribe" method="post" data-newsletter>
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input
            id="newsletter-email"
            type="email"
            name="email"
            placeholder="you@example.com"
            autocomplete="email"
            required
            class="block w-full h-11 px-4 text-base border-0 rounded-md bg-background text-foreground placeholder:text-muted-foreground focus:ring-0 focus:outline-2 focus:outline-offset-4 focus:outline-ring"
          />
          <div class="absolute -left-[9999px]" aria-hidden="true">
            <label for="newsletter-website">Leave this empty</label>
            <input id="newsletter-website" type="text" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <Button type="submit" variant="primary" size="md" class="shrink-0">Join</Button>
        </form>
        <p
          class="min-h-5 text-sm text-muted-foreground data-[tone=error]:text-accent"
          role="status"
          data-newsletter-status
          data-tone={status === 'invalid' || status === 'error' ? 'error' : undefined}
        >
          {message}
        </p>
      </div>
    </Grid>
  </Wrapper>
</section>

<script>
  const MESSAGES: Record<string, string> = {
    subscribed: 'Thanks! You’re on the list.',
    confirm: 'Almost done! Check your inbox to confirm.',
    already: 'You’re already on the list. Thank you!',
    invalid: 'Please enter a valid email address.',
    error: 'Something went wrong. Please try again.',
  };
  const form = document.querySelector<HTMLFormElement>('[data-newsletter]');
  const statusEl = document.querySelector<HTMLElement>('[data-newsletter-status]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector('button')!;
    button.disabled = true;
    let status = 'error';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
      status = (await res.json()).status ?? 'error';
    } catch {
      // network error: keep 'error'
    }
    button.disabled = false;
    if (statusEl) {
      statusEl.textContent = MESSAGES[status] ?? MESSAGES.error;
      if (status === 'invalid' || status === 'error') statusEl.dataset.tone = 'error';
      else delete statusEl.dataset.tone;
    }
    if (status === 'subscribed' || status === 'confirm' || status === 'already') form.reset();
  });
</script>
