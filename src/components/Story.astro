---
import Text from './fundations/elements/Text.astro';
import TextLink from './fundations/elements/TextLink.astro';
import Wrapper from './fundations/containers/Wrapper.astro';
import Grid from './fundations/containers/Grid.astro';
---

<section id="story">
  <Wrapper variant="standard" class="py-24">
    <Grid class="gap-y-12">
      <div class="relative col-span-12 overflow-hidden lg:col-span-6 rounded-xl">
        <img
          src="/images/story-kitchen.jpg"
          alt="Three jars of Jamn Good strawberry jam stacked on a rustic kitchen table beside a vase of daisies and a bowl of strawberries"
          width="1008"
          height="596"
          loading="lazy"
          class="object-cover w-full h-full aspect-4/3 lg:absolute lg:inset-0 lg:aspect-auto"
        />
      </div>
      <div class="flex flex-col justify-between col-span-12 gap-12 p-8 rounded-xl bg-muted lg:col-span-6">
        <div class="flex flex-col gap-6">
          <Text tag="p" variant="textSM" class="text-muted-foreground">Our story</Text>
          <Text tag="h2" variant="displayMD" class="tracking-tighter text-foreground font-medium text-balance">
            It all started in our kitchen.
          </Text>
        </div>
        <div class="flex flex-col gap-6">
          <Text tag="p" variant="textBase" class="max-w-lg text-muted-foreground text-pretty">
            What began as a love for homemade jam quickly turned into a passion for sharing it with others. Jamn Good is
            our way of spreading a little joy, one jar at a time.
          </Text>
          <TextLink href="/where-to-find-us">Come say hi</TextLink>
        </div>
      </div>
    </Grid>
  </Wrapper>
</section>
