---
import Text from './fundations/elements/Text.astro';
import Button from './fundations/elements/Button.astro';
import TextLink from './fundations/elements/TextLink.astro';
import Wrapper from './fundations/containers/Wrapper.astro';
import { getFeaturedProducts } from '../lib/content';

// The pills between the words are the homepage jars' photos, in their homepage order.
const photos = (await getFeaturedProducts()).map((p) => (p.home ?? p.image)?.src).filter(Boolean) as string[];
const lines = [
  { text: 'Spread a little', after: '', rest: '' },
  { text: 'happiness,', after: '', rest: '' },
  { text: 'one small batch', after: ' jar', rest: 'at a time.' },
].map((line, i) => ({ ...line, image: photos[i] }));

const pill =
  'inline-block object-cover h-10 w-16 align-middle rounded-full sm:h-14 sm:w-24 lg:h-20 lg:w-36 duration-300 ease-out hover:-rotate-6 hover:scale-110 pill-pop';
---

<section>
  <Wrapper
    variant="standard"
    class="flex flex-col items-center justify-center gap-12 pt-48 pb-32 min-h-160 lg:min-h-svh 2xl:min-h-200"
  >
    <h1
      class="max-w-6xl text-5xl tracking-tighter text-center sm:text-6xl lg:text-8xl text-foreground font-medium text-balance"
    >
      {
        lines.map((line, i) => (
          <span>
            {line.text}{' '}
            {line.image && (
              <span class="whitespace-nowrap">
                <img
                  src={line.image}
                  alt=""
                  width="300"
                  height="250"
                  loading="eager"
                  class={pill}
                  style={`animation-delay: ${0.2 + i * 0.12}s`}
                />
                {line.after}
              </span>
            )}
            {!line.image && line.after}{' '}
            {line.rest}
          </span>
        ))
      }
    </h1>
    <div class="flex flex-col items-center gap-8">
      <Text tag="p" variant="textLG" class="max-w-md text-center text-muted-foreground text-balance">
        Made with real fruit, simple ingredients and a whole lotta love.
      </Text>
      <div class="flex flex-wrap items-center justify-center gap-6">
        <Button isLink href="/shop" variant="primary" size="md">Shop our jams</Button>
        <TextLink href="/where-to-find-us">Where to find us</TextLink>
      </div>
    </div>
  </Wrapper>
</section>
