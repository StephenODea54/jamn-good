---
import Text from './fundations/elements/Text.astro';
import Wrapper from './fundations/containers/Wrapper.astro';
import Grid from './fundations/containers/Grid.astro';

const features = [
  { title: 'Small batch', text: 'Made in small batches for the best flavor.' },
  { title: 'Real ingredients', text: 'We use real fruit and simple ingredients.' },
  { title: 'Made with love', text: 'Every jar is made with care.' },
  { title: 'Local and proud', text: 'Supporting our local community.' },
];
---

<section aria-labelledby="features-title">
  <Wrapper variant="standard" class="py-24">
    <div class="flex flex-col gap-16">
      <div class="flex flex-col max-w-2xl gap-4">
        <Text id="features-title" tag="h2" variant="displaySM" class="tracking-tight text-foreground font-medium text-balance">
          Homemade, the way jam should be.
        </Text>
      </div>
      <Grid tag="ul" class="gap-y-10">
        {
          features.map((f) => (
            <li class="flex flex-col col-span-12 gap-1 sm:col-span-6 lg:col-span-3">
              <Text tag="h3" variant="textLG" class="tracking-tight text-foreground font-medium">
                {f.title}
              </Text>
              <Text tag="p" variant="textSM" class="text-muted-foreground text-pretty">
                {f.text}
              </Text>
            </li>
          ))
        }
      </Grid>
    </div>
  </Wrapper>
</section>
