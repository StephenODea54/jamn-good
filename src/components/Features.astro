---
const features = [
  {
    icon: '/images/icon-small-batch.png',
    w: 60, h: 62, dx: 1, dy: 4,
    title: 'Small Batch',
    text: ['Made in small batches', 'for the best flavor.'],
  },
  {
    icon: '/images/icon-real-ingredients.png',
    w: 52, h: 60, dx: 2, dy: 5,
    title: 'Real Ingredients',
    text: ['We use real fruit and', 'simple ingredients.'],
  },
  {
    icon: '/images/icon-made-with-love.png',
    w: 48, h: 61, dx: -1, dy: 4,
    title: 'Made With Love',
    text: ['Every jar is made', 'with care.'],
  },
  {
    icon: '/images/icon-local-proud.png',
    w: 95, h: 53, dx: 0, dy: 7,
    title: 'Local & Proud',
    text: ['Supporting our local', 'community.'],
  },
];
---

<section class="features" aria-label="Why Jamn Good">
  <div class="wrap">
    <ul class="features__list">
      {
        features.map((f) => (
          <li class="feature">
            <div class="feature__icon">
              <img
                src={f.icon}
                alt=""
                width={f.w}
                height={f.h}
                style={`transform: translate(${f.dx}px, ${f.dy}px)`}
              />
            </div>
            <h3 class="feature__title">{f.title}</h3>
            <p class="feature__text">
              {f.text[0]}
              <br />
              {f.text[1]}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .features {
    position: relative;
    height: 145px;
    background: var(--paper-deep) url('/images/bg-features.jpg') center top / auto 145px no-repeat;
  }

  .features__list {
    position: absolute;
    left: 77px;
    top: 0;
    width: 866px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .feature {
    position: relative;
    height: 145px;
    text-align: center;
  }

  .feature + .feature::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    height: 120px;
    border-left: 1px dotted rgba(140, 110, 80, 0.5);
  }

  .feature__icon {
    height: 66px;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .feature__title {
    margin-top: 5px;
    font-family: var(--font-subhead);
    font-size: 10.7px;
    font-weight: 700;
    line-height: 18px;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    color: #453d22;
  }

  .feature__text {
    margin-top: 2px;
    font-size: 12.5px;
    line-height: 16px;
    color: var(--ink-muted);
  }

  @media (max-width: 1023px) {
    .features {
      height: auto;
      padding: 28px 16px;
      background-size: cover;
    }

    .features__list {
      position: static;
      width: auto;
      max-width: 640px;
      margin: 0 auto;
      grid-template-columns: repeat(2, 1fr);
      row-gap: 28px;
    }

    .feature {
      height: auto;
    }

    .feature + .feature::before {
      display: none;
    }
  }
</style>
