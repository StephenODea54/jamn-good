---
import Button from './fundations/elements/Button.astro';
import { productUrl } from '../data/products';
import { getProducts } from '../lib/content';

const catalog = Object.fromEntries(
  (await getProducts()).map((p) => [
    p.slug,
    { name: p.name, price: p.price, image: p.image?.src ?? '', url: productUrl(p), outOfStock: p.outOfStock },
  ]),
);
---

<!-- Opened by any [data-cart-open] button; src/scripts/cart.ts fills it from localStorage. -->
<div class="fixed inset-0 z-50 pointer-events-none group/cart data-open:pointer-events-auto" data-cart-root inert>
  <div
    class="absolute inset-0 duration-300 opacity-0 bg-foreground/40 group-data-open/cart:opacity-100"
    data-cart-close
  ></div>

  <aside
    class="absolute inset-y-0 right-0 flex flex-col w-full max-w-md gap-6 p-8 duration-300 ease-out translate-x-full bg-background group-data-open/cart:translate-x-0"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cart-title"
  >
    <header class="flex items-center justify-between">
      <h2 id="cart-title" class="text-2xl tracking-tight font-medium text-foreground">Your cart</h2>
      <button
        type="button"
        class="text-sm font-medium duration-200 cart-drawer__close hover:text-muted-foreground"
        data-cart-close
      >
        Close
      </button>
    </header>

    <ul class="flex flex-col flex-1 gap-4 -mx-2 px-2 overflow-y-auto" data-cart-lines></ul>
    <p class="flex-1 text-muted-foreground" data-cart-empty hidden>Your cart is empty. Time for some jam!</p>

    <footer class="flex flex-col gap-4 pt-6">
      <div class="flex items-center justify-between text-lg font-medium tracking-tight">
        <span>Subtotal</span>
        <span class="tabular-nums" data-cart-subtotal>$0.00</span>
      </div>
      <p class="text-sm text-muted-foreground">Local pickup only. We’ll reach out after you order to set up a time.</p>
      <p class="text-sm text-accent" role="alert" data-cart-error hidden></p>
      <Button type="button" variant="primary" size="md" class="w-full" data-cart-checkout>Checkout</Button>
      <Button type="button" variant="muted" size="md" class="w-full" data-cart-close>Continue shopping</Button>
    </footer>
  </aside>

  <template id="cart-line-template">
    <li class="flex items-center gap-4 cart-line group/line">
      <a class="block overflow-hidden rounded-xl bg-muted shrink-0 size-20" data-line-link>
        <img alt="" width="80" height="80" class="object-cover size-full group-data-out-of-stock/line:opacity-60" data-line-img />
      </a>
      <div class="flex flex-col flex-1 min-w-0 gap-1">
        <a class="font-medium tracking-tight duration-200 truncate hover:text-muted-foreground" data-line-link data-line-name></a>
        <p class="text-sm text-muted-foreground tabular-nums group-data-out-of-stock/line:text-accent" data-line-price></p>
        <div class="flex items-center gap-3">
          <div class="h-8 text-sm qty" data-line-qty>
            <button type="button" aria-label="Decrease quantity" data-line-dec>−</button>
            <span class="w-8!" data-line-count></span>
            <button type="button" aria-label="Increase quantity" data-line-inc>+</button>
          </div>
          <button
            type="button"
            class="text-sm duration-200 text-muted-foreground hover:text-foreground"
            aria-label="Remove"
            data-line-remove
          >
            Remove
          </button>
        </div>
      </div>
    </li>
  </template>

  <script type="application/json" id="cart-catalog" set:html={JSON.stringify(catalog)} />
</div>

<script>
  import { initCart } from '../scripts/cart';
  initCart();
</script>
