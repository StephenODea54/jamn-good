---
import { productUrl } from '../data/products';
import { getProducts } from '../lib/content';

const catalog = Object.fromEntries(
  (await getProducts()).map((p) => [
    p.slug,
    { name: p.name, price: p.price, image: p.image?.src ?? '', url: productUrl(p), outOfStock: p.outOfStock },
  ]),
);
---

<div class="cart-drawer" data-cart-root inert>
  <div class="cart-drawer__scrim" data-cart-close></div>

  <aside class="cart-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="cart-title">
    <header class="cart-drawer__head">
      <h2 id="cart-title">Your Cart</h2>
      <button type="button" class="cart-drawer__close" aria-label="Close cart" data-cart-close>
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M4 4l12 12M16 4 4 16" /></svg>
      </button>
    </header>

    <ul class="cart-drawer__lines" data-cart-lines></ul>
    <p class="cart-drawer__empty" data-cart-empty hidden>Your cart is empty. Time for some jam!</p>

    <footer class="cart-drawer__foot">
      <div class="cart-drawer__subtotal">
        <span>Subtotal</span>
        <span data-cart-subtotal>$0.00</span>
      </div>
      <p class="cart-drawer__note">Local pickup only. We’ll reach out after you order to set up a time.</p>
      <p class="cart-drawer__error" role="alert" data-cart-error hidden></p>
      <button type="button" class="cart-drawer__checkout" data-cart-checkout>Checkout</button>
      <button type="button" class="cart-drawer__continue" data-cart-close>Continue Shopping</button>
    </footer>
  </aside>

  <template id="cart-line-template">
    <li class="cart-line">
      <a class="cart-line__media" data-line-link><img alt="" width="80" height="80" data-line-img /></a>
      <div class="cart-line__info">
        <a class="cart-line__name" data-line-link data-line-name></a>
        <p class="cart-line__price" data-line-price></p>
      </div>
      <div class="qty qty--small" data-line-qty>
        <button type="button" aria-label="Decrease quantity" data-line-dec>−</button>
        <span data-line-count></span>
        <button type="button" aria-label="Increase quantity" data-line-inc>+</button>
      </div>
      <button type="button" class="cart-line__remove" aria-label="Remove" data-line-remove>
        <svg viewBox="0 0 16 18" width="16" height="18" aria-hidden="true">
          <path d="M1.5 4h13M6 4V2.2h4V4M3.2 4l.8 12h8l.8-12M6.5 7v6.5M9.5 7v6.5" />
        </svg>
      </button>
    </li>
  </template>

  <script type="application/json" id="cart-catalog" set:html={JSON.stringify(catalog)} />
</div>

<script>
  import { initCart } from '../scripts/cart';
  initCart();
</script>

<style>
  .cart-drawer {
    position: fixed;
    inset: 0;
    z-index: 50;
    pointer-events: none;
  }

  .cart-drawer[data-open] {
    pointer-events: auto;
  }

  .cart-drawer__scrim {
    position: absolute;
    inset: 0;
    background: rgba(40, 32, 24, 0.55);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cart-drawer[data-open] .cart-drawer__scrim {
    opacity: 1;
  }

  .cart-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(452px, 100%);
    display: flex;
    flex-direction: column;
    padding: 30px 32px 32px 42px;
    background: var(--paper) url('/images/paper.jpg') repeat;
    box-shadow: -12px 0 30px rgba(40, 30, 20, 0.18);
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.22, 0.8, 0.3, 1);
  }

  .cart-drawer[data-open] .cart-drawer__panel {
    transform: none;
  }

  .cart-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-drawer__head h2 {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 600;
    color: var(--ink);
  }

  .cart-drawer__close {
    width: 32px;
    height: 32px;
    margin-right: -6px;
    padding: 6px;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }

  .cart-drawer__close svg,
  .cart-line__remove svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* the summary follows the items (as in the mockup); a long cart scrolls */
  .cart-drawer__lines {
    flex: 0 1 auto;
    min-height: 0;
    overflow-y: auto;
    margin: 22px -8px 0 0;
    padding-right: 8px;
  }

  .cart-drawer__empty {
    margin: 32px 0;
    font-size: 14px;
    color: var(--ink-soft);
  }

  .cart-line {
    display: grid;
    grid-template-columns: 80px 1fr auto 24px;
    grid-template-rows: auto auto;
    column-gap: 16px;
    padding: 14px 0;
  }

  .cart-line__media {
    grid-row: 1 / 3;
    width: 80px;
    height: 80px;
    overflow: hidden;
    border-radius: 2px;
    box-shadow: 0 1px 3px rgba(60, 40, 20, 0.15);
  }

  .cart-line__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-line__info {
    grid-column: 2 / 5;
    padding-top: 2px;
  }

  .cart-line__name {
    font-family: var(--font-subhead);
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
  }

  .cart-line[data-out-of-stock] .cart-line__price {
    font-style: italic;
    color: var(--rust);
  }

  .cart-line[data-out-of-stock] .cart-line__media {
    opacity: 0.55;
  }

  .cart-line__price {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    color: #923b1f;
  }

  .cart-line .qty {
    grid-column: 3;
    align-self: end;
  }

  .cart-line__remove {
    grid-column: 4;
    align-self: end;
    width: 24px;
    height: 26px;
    padding: 4px;
    border: 0;
    background: none;
    color: #6e6150;
    cursor: pointer;
  }

  .cart-line__remove:hover {
    color: var(--rust);
  }

  .cart-drawer__foot {
    margin: 8px -32px 0 -42px;
    padding: 22px 32px 0 42px;
    border-top: 1px solid rgba(150, 120, 90, 0.25);
  }

  .cart-drawer__subtotal {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-subhead);
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
  }

  .cart-drawer__subtotal [data-cart-subtotal] {
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .cart-drawer__note {
    margin-top: 8px;
    font-size: 11.5px;
    color: var(--ink-muted);
  }

  .cart-drawer__error {
    margin-top: 12px;
    padding: 10px 12px;
    border-left: 3px solid var(--rust);
    background: rgba(171, 80, 46, 0.08);
    font-size: 13px;
    line-height: 1.5;
    color: #7d321a;
  }

  .cart-drawer__checkout[aria-busy='true'] {
    cursor: progress;
    opacity: 0.75;
  }

  .cart-drawer__checkout,
  .cart-drawer__continue {
    display: block;
    width: 100%;
    height: 48px;
    margin-top: 20px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .cart-drawer__checkout {
    border: 0;
    background: var(--olive);
    color: #efeddc;
  }

  .cart-drawer__checkout:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .cart-drawer__checkout:not(:disabled):hover {
    background: #4f4c28;
  }

  .cart-drawer__continue {
    margin-top: 12px;
    border: 1px solid #8d866c;
    background: transparent;
    color: #544e2c;
  }

  .cart-drawer__continue:hover {
    background: rgba(99, 96, 53, 0.08);
  }

  @media (max-width: 480px) {
    .cart-drawer__panel {
      padding: 24px 20px 24px 24px;
    }

    .cart-drawer__foot {
      margin: 0 -20px 0 -24px;
      padding: 20px 20px 0 24px;
    }
  }
</style>
