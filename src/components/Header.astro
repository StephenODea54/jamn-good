---
import Wrapper from './fundations/containers/Wrapper.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { label: 'Shop', href: '/shop' },
  { label: 'Where to find us', href: '/where-to-find-us' },
  { label: 'FAQ', href: '/faq' },
  { label: 'Newsletter', href: '/newsletter' },
  { label: 'Contact', href: '/contact' },
];
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
const logo = { src: '/images/logo.webp', alt: 'Jamn Good', width: 640, height: 469 };
---

<!-- Lies over the top of each page's hero, which leaves room for it. -->
<header data-nav class="absolute inset-x-0 top-0 z-40 text-foreground">
  <Wrapper variant="standard">
    <nav class="flex items-center justify-between h-24 gap-8 text-sm" aria-label="Main">
      <a href="/" aria-label="Jamn Good home" class="shrink-0 lg:w-48">
        <img {...logo} class="w-auto h-20" />
      </a>
      <ul class="items-center hidden gap-8 lg:flex">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                class:list={['font-medium duration-200 hover:opacity-100', isCurrent(link.href) ? 'opacity-100' : 'opacity-70']}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="flex items-center justify-end gap-6 lg:w-48">
        <button type="button" data-cart-open class="flex items-center gap-2 font-medium duration-200 hover:opacity-70">
          Cart
          <span
            data-cart-count
            hidden
            class="grid px-1.5 text-xs rounded-full min-w-5 h-5 place-items-center bg-accent text-accent-foreground tabular-nums"
          ></span>
        </button>
        <button
          type="button"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="menu"
          class="font-medium duration-200 lg:hidden hover:opacity-70"
        >
          Menu
        </button>
      </div>
    </nav>
  </Wrapper>
  <div id="menu" data-nav-menu class="fixed inset-0 hidden overflow-y-auto bg-background text-foreground lg:hidden">
    <Wrapper variant="standard" class="pb-8">
      <div class="flex items-center justify-between h-24 text-sm">
        <a href="/" aria-label="Jamn Good home"><img {...logo} class="w-auto h-20" /></a>
        <button type="button" data-nav-close class="font-medium duration-200 hover:text-muted-foreground">Close</button>
      </div>
      <ul class="flex flex-col gap-2 py-6">
        <li><a href="/" class="text-3xl tracking-tight duration-200 hover:text-muted-foreground">Home</a></li>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                class="text-3xl tracking-tight duration-200 hover:text-muted-foreground"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </Wrapper>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const close = header?.querySelector<HTMLButtonElement>('[data-nav-close]');
  const menu = header?.querySelector<HTMLElement>('[data-nav-menu]');

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) close?.focus();
    else toggle.focus();
  };

  toggle?.addEventListener('click', () => setOpen(true));
  close?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') setOpen(false);
  });
</script>
