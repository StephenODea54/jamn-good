---
import TextLink from './fundations/elements/TextLink.astro';
import Wrapper from './fundations/containers/Wrapper.astro';
import EmojiPill from './EmojiPill.astro';
---

<section>
  <Wrapper variant="standard" class="flex flex-col items-center gap-10 py-24">
    <h2
      class="max-w-5xl text-5xl tracking-tighter text-center sm:text-6xl lg:text-8xl text-foreground font-medium text-balance"
    >
      Life’s too short for{' '}
      <EmojiPill emoji="🍋" />{' '}
      boring toast.
    </h2>
    <TextLink href="/shop">Find your flavor</TextLink>
  </Wrapper>
</section>
