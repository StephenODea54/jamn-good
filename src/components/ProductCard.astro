---
import { type Product, formatPrice, productUrl } from '../data/products';

interface Props {
  product: Product;
}

const { product: p } = Astro.props;
const url = productUrl(p);
---

<article class="card" data-kind={p.kind} data-limited={p.limited ? "true" : "false"}>
  <a href={url} class="card__media" tabindex="-1" aria-hidden="true">
    {p.image && <img src={p.image.src} alt="" width="300" height="294" loading="lazy" />}
  </a>
  <h3 class="card__name"><a href={url}>{p.name}</a></h3>
  <p class="card__price">{formatPrice(p.price)}</p>
  {p.note && <p class="card__note">{p.note}</p>}
  <button type="button" class="btn btn--olive card__add" data-add-to-cart={p.slug}>Add to Cart</button>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .card__media {
    display: block;
    width: 100%;
    aspect-ratio: 300 / 294;
    overflow: hidden;
    border-radius: 2px;
    box-shadow: 0 1px 4px rgba(60, 40, 20, 0.14);
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card__media:hover img {
    transform: scale(1.03);
  }

  .card__name {
    margin-top: 19px;
    font-family: var(--font-subhead);
    font-size: 15px;
    font-weight: 700;
    line-height: 22px;
    color: #24190e;
  }

  .card__name a:hover {
    color: var(--rust);
  }

  .card__price {
    position: relative;
    margin-top: 6px;
    padding-bottom: 8px;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    color: #923b1f;
  }

  .card__price::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 46px;
    height: 2px;
    transform: translateX(-50%);
    background: rgba(161, 85, 50, 0.6);
  }

  .card__note {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: #923b1f;
  }

  .card__add {
    margin-top: 14px;
    width: 150px;
  }
</style>
