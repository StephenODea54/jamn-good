---
import Text from './fundations/elements/Text.astro';
import Button from './fundations/elements/Button.astro';
import StockBadge from './StockBadge.astro';
import { type Product, formatPrice, productUrl } from '../data/products';

interface Props {
  product: Product;
  /** Load the photo straight away (cards near the top of the page) */
  eager?: boolean;
}

const { product: p, eager = false } = Astro.props;
const url = productUrl(p);
---

<article
  class="flex flex-col gap-4 group"
  data-kind={p.kind}
  data-limited={p.limited ? 'true' : 'false'}
  data-out-of-stock={p.outOfStock ? 'true' : undefined}
>
  <a href={url} class="relative block overflow-hidden rounded-xl bg-muted" tabindex="-1" aria-hidden="true">
    {
      p.image && (
        <img
          src={p.image.src}
          alt=""
          width={p.image.width ?? 1000}
          height={p.image.height ?? 980}
          loading={eager ? 'eager' : 'lazy'}
          class:list={[
            'object-cover w-full duration-500 ease-out aspect-square group-hover:scale-105',
            { 'opacity-60': p.outOfStock },
          ]}
        />
      )
    }
    {p.outOfStock ? <StockBadge /> : p.preorder && <StockBadge>Pre-order</StockBadge>}
  </a>
  <div class="flex flex-col items-start gap-4">
    <div class="flex flex-col gap-1">
      <Text tag="h3" variant="textLG" class="tracking-tight text-foreground font-medium">
        <a href={url} class="duration-200 hover:text-muted-foreground">{p.name}</a>
      </Text>
      <Text tag="p" variant="textSM" class="text-muted-foreground tabular-nums">
        {p.note ? `${formatPrice(p.price)} ${p.note}` : formatPrice(p.price)}
      </Text>
    </div>
    {
      p.outOfStock ? (
        <Button variant="muted" size="sm" disabled>
          Sold out
        </Button>
      ) : (
        <Button variant="muted" size="sm" data-add-to-cart={p.slug}>
          {p.preorder ? 'Pre-order' : 'Add to cart'}
        </Button>
      )
    }
  </div>
</article>
