---
import Text from './fundations/elements/Text.astro';
import Button from './fundations/elements/Button.astro';
import Wrapper from './fundations/containers/Wrapper.astro';
import Grid from './fundations/containers/Grid.astro';
import { getTreats } from '../lib/content';

const treats = await getTreats();
---

<section aria-labelledby="treats-title">
  <Wrapper variant="standard" class="py-24">
    <Grid class="gap-y-12">
      <div class="flex flex-col justify-between col-span-12 gap-10 lg:col-span-6">
        <div class="flex flex-col max-w-xl gap-4">
          <Text tag="p" variant="textSM" class="text-muted-foreground">Cookies and treats</Text>
          <Text id="treats-title" tag="h2" variant="displayMD" class="tracking-tighter text-foreground font-medium text-balance">
            Sweets for your special day.
          </Text>
          <Text tag="p" variant="textBase" class="text-muted-foreground text-pretty">
            We bake custom cookies for weddings, parties, and all kinds of special events. Tell us about your celebration
            and we’ll help make it a little sweeter.
          </Text>
        </div>
        <Button isLink href="/contact?topic=events" variant="primary" size="md" class="w-fit">Ask about event orders</Button>
      </div>
      <div class="flex flex-col col-span-12 gap-6 p-8 rounded-xl bg-muted lg:col-span-6">
        <Text tag="h3" variant="textLG" class="tracking-tight text-foreground font-medium">Also from our kitchen</Text>
        <ul class="flex flex-col gap-3">
          {
            treats.map((t) => (
              <li class="flex items-center gap-3 text-base text-foreground">
                <span aria-hidden="true" class="rounded-full size-1.5 shrink-0 bg-foreground" />
                {t}
              </li>
            ))
          }
          <li class="flex items-center gap-3 text-base text-muted-foreground">
            <span aria-hidden="true" class="rounded-full size-1.5 shrink-0 bg-muted-foreground" />
            And more seasonal favorites
          </li>
        </ul>
      </div>
    </Grid>
  </Wrapper>
</section>
