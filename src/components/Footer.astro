---
import Text from './fundations/elements/Text.astro';
import Wrapper from './fundations/containers/Wrapper.astro';
import Grid from './fundations/containers/Grid.astro';
import { getSiteDetails } from '../lib/content';

const site = await getSiteDetails();

const columns = [
  {
    title: 'Shop',
    links: [
      { label: 'All jams', href: '/shop' },
      { label: 'Where to find us', href: '/where-to-find-us' },
      { label: 'Event orders', href: '/contact?topic=events' },
      { label: 'Wholesale', href: '/contact?topic=wholesale' },
    ],
  },
  {
    title: 'Help',
    links: [
      { label: 'FAQ', href: '/faq' },
      { label: 'Newsletter', href: '/newsletter' },
      { label: 'Contact', href: '/contact' },
    ],
  },
  {
    title: 'Follow',
    links: [
      site.instagram && { label: 'Instagram', href: site.instagram },
      site.facebook && { label: 'Facebook', href: site.facebook },
    ].filter((l): l is { label: string; href: string } => Boolean(l)),
  },
].filter((c) => c.links.length > 0);

const year = new Date().getFullYear();
---

<footer>
  <Wrapper variant="standard" class="py-24">
    <div class="flex flex-col gap-24">
      <Grid class="gap-y-12">
        <div class="flex flex-col col-span-12 gap-6 lg:col-span-6">
          <a href="/" aria-label="Jamn Good home" class="w-fit">
            <img src="/images/logo.webp" alt="Jamn Good" width="640" height="469" loading="lazy" class="w-auto h-28" />
          </a>
          <Text tag="p" variant="displayMD" class="max-w-md tracking-tight text-foreground font-medium text-balance">
            Small batch jam, made by hand in Youngstown.
          </Text>
          <a
            href={`mailto:${site.email}`}
            class="text-base font-medium duration-200 w-fit text-muted-foreground hover:text-foreground"
          >
            {site.email}
          </a>
        </div>
        <div class="grid grid-cols-2 col-span-12 gap-8 sm:grid-cols-3 lg:col-span-6 lg:pt-34">
          {
            columns.map((column) => (
              <div class="flex flex-col gap-4">
                <Text tag="p" variant="textSM" class="text-muted-foreground">
                  {column.title}
                </Text>
                <ul class="flex flex-col gap-2 text-sm font-medium">
                  {column.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class="duration-200 text-foreground hover:text-muted-foreground"
                        {...(link.href.startsWith('http') && { target: '_blank', rel: 'noopener' })}
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </Grid>
      <div class="flex flex-col justify-between gap-2 text-sm sm:flex-row text-muted-foreground">
        <span>&copy; <span data-year>{year}</span> Jamn Good LLC</span>
        <span>Local pickup in Youngstown, Ohio</span>
      </div>
    </div>
  </Wrapper>
</footer>

<script>
  // Pages can be cached, so keep the year current.
  document.querySelectorAll('[data-year]').forEach((el) => (el.textContent = String(new Date().getFullYear())));
</script>
