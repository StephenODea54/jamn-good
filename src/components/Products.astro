---
import Text from './fundations/elements/Text.astro';
import TextLink from './fundations/elements/TextLink.astro';
import Wrapper from './fundations/containers/Wrapper.astro';
import Grid from './fundations/containers/Grid.astro';
import ProductCard from './ProductCard.astro';
import { getFeaturedProducts } from '../lib/content';

// Products with a "Homepage position" in EmDash.
const featured = await getFeaturedProducts();
---

<section id="shop">
  <Wrapper variant="standard" class="py-24">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="flex flex-col max-w-xl gap-4">
        <Text tag="h2" variant="displaySM" class="tracking-tight text-foreground font-medium">
          Homemade goodness in every jar
        </Text>
        <Text tag="p" variant="textBase" class="text-muted-foreground text-pretty">
          Made in small batches with real fruit and simple ingredients, for the best flavor.
        </Text>
      </div>
      <TextLink href="/shop" class="shrink-0">Shop all jams</TextLink>
    </div>
    <Grid tag="ul" class="mt-12 gap-y-12">
      {
        featured.map((product) => (
          <li class="col-span-12 sm:col-span-6 lg:col-span-3">
            <ProductCard product={product} />
          </li>
        ))
      }
    </Grid>
  </Wrapper>
</section>
