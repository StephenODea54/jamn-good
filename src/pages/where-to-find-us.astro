---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { storeMapsUrl, eventParts, mapsUrl, upcoming } from '../data/markets';
import { getEvents, getStores } from '../lib/content';

// Stores and events are edited in EmDash.
const [stores, events] = await Promise.all([getStores(), getEvents()]);
const VISIBLE_EVENTS = 4;
const list = upcoming(events);

const arrow = `<svg viewBox="0 0 16 10" width="14" height="9" aria-hidden="true"><path d="M1 5h13M10 1l4 4-4 4" /></svg>`;
---

<Base title="Where to Find Us | Jamn Good" description="Find Jamn Good jam at local stores, flea markets and craft shows.">
  <div class="page">
    <section class="hero">
      <img class="hero__botanical" src="/images/market/botanical-hero.png" alt="" width="104" height="306" />
      <div class="wrap">
        <Header />
        <div class="hero__copy">
          <p class="hero__eyebrow eyebrow">Local Stores, Markets &amp; Events</p>
          <h1 class="hero__title">Where to <span>Find Jamn Good</span></h1>
          <p class="hero__lede">
            From local grocery stores to flea markets and craft shows, we love getting our jams into the community. Here’s
            where you can find us next!
          </p>
          <a href="#events" class="btn btn--rust hero__cta">View Upcoming Events <Fragment set:html={arrow} /></a>
        </div>
      </div>
    </section>

    <main>
      <section class="stores" aria-labelledby="stores-title">
        <img class="stores__vine" src="/images/market/botanical-vine.png" alt="" width="166" height="208" />
        <div class="wrap">
          <p class="stores__eyebrow eyebrow"><span>In Local Stores</span></p>
          <h2 id="stores-title" class="stores__title">
            Look for Jamn Good at {stores.length === 1 ? 'this location' : 'these locations'}!
          </h2>
          <ul class="stores__list">
            {
              stores.map((s) => (
                <li class="store">
                  <p class="store__name" style={s.color ? `color: ${s.color}` : undefined}>
                    {s.name}
                    {s.branch && <span class="store__tagline">{s.branch}</span>}
                  </p>
                  <address class="store__note">
                    {s.street}
                    <br />
                    {s.city}
                  </address>
                  <a class="store__directions" href={storeMapsUrl(s)} target="_blank" rel="noopener">
                    Get directions<span class="visually-hidden"> to {s.name} {s.branch} (opens map in a new tab)</span>
                  </a>
                </li>
              ))
            }
            <li class="store store--more">
              <p class="store__more">More shops<br />coming soon</p>
              <p class="store__note">Check back often<br />for new locations!</p>
            </li>
          </ul>
        </div>
      </section>

      <section class="events" id="events" aria-labelledby="events-title">
        <img class="events__botanical" src="/images/market/botanical-band.png" alt="" width="100" height="206" />
        <div class="wrap">
          <div class="events__intro">
            <p class="events__eyebrow eyebrow">Upcoming Events</p>
            <h2 id="events-title" class="events__title">Come say hi!</h2>
            <p class="events__text">
              We love meeting new faces and being part of local markets, craft shows, and community events. Here’s where
              you can find us next.
            </p>
            {
              list.length > VISIBLE_EVENTS && (
                <button type="button" class="btn btn--outline events__more" data-more-events aria-expanded="false">
                  View Full Event Calendar
                </button>
              )
            }
          </div>

          {
            list.length > 0 ? (
              <ol class="events__list" data-events>
                {list.map((e, i) => {
                  const { month, day } = eventParts(e);
                  return (
                    <li data-date={e.date} hidden={i >= VISIBLE_EVENTS}>
                      <a class="event" href={mapsUrl(e)} target="_blank" rel="noopener">
                        <span class="event__date">
                          <span class="event__month">{month}</span>
                          <span class="event__day">{day}</span>
                        </span>
                        <span class="event__body">
                          <span class="event__name">{e.name}</span>
                          <span class="event__meta">
                            <span>
                              <svg viewBox="0 0 12 14" width="11" height="13" aria-hidden="true">
                                <path d="M6 13s4.5-4.2 4.5-7.4a4.5 4.5 0 0 0-9 0C1.5 8.8 6 13 6 13Z" />
                                <circle cx="6" cy="5.6" r="1.6" />
                              </svg>
                              {e.town}
                            </span>
                            <span>
                              <svg viewBox="0 0 14 14" width="12" height="12" aria-hidden="true">
                                <circle cx="7" cy="7" r="5.8" />
                                <path d="M7 3.8V7l2.2 1.4" />
                              </svg>
                              {e.start && e.end ? `${e.start} to ${e.end}` : (e.start ?? e.end ?? 'Times to be announced')}
                            </span>
                          </span>
                        </span>
                        <svg class="event__chevron" viewBox="0 0 8 14" width="8" height="14" aria-hidden="true">
                          <path d="m1 1 6 6-6 6" />
                        </svg>
                        <span class="visually-hidden">(opens map in a new tab)</span>
                      </a>
                    </li>
                  );
                })}
                {list.length < VISIBLE_EVENTS && (
                  <li class="events__soon">More dates coming soon. Check back often!</li>
                )}
              </ol>
            ) : (
              <p class="events__empty">New dates coming soon. Check back shortly!</p>
            )
          }

          <img
            class="events__polaroid"
            src="/images/market/polaroid.webp"
            alt="Polaroid of the Jamn Good market booth, captioned See you at the next one!"
            width="246"
            height="232"
            loading="lazy"
          />
        </div>
      </section>

      <section class="wholesale" aria-labelledby="wholesale-title">
        <img class="wholesale__jar" src="/images/market/jar-lineart.png" alt="" width="126" height="114" loading="lazy" />
        <img class="wholesale__sprig" src="/images/market/botanical-green.png" alt="" width="120" height="117" loading="lazy" />
        <div class="wrap">
          <div class="wholesale__copy">
            <p class="wholesale__eyebrow eyebrow">Interested in carrying our jams?</p>
            <h2 id="wholesale-title" class="wholesale__title">We’d love to work with you!</h2>
            <p class="wholesale__text">
              If you’re a local shop, market, or organization interested in carrying Jamn Good, we’d love to hear from
              you.
            </p>
          </div>
          <a href="/contact?topic=wholesale" class="btn wholesale__cta">Inquire About Wholesale <Fragment set:html={arrow} /></a>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Base>

<script>
  // The page is static: drop events that have passed since the last build.
  const today = new Date();
  const iso = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
  const items = [...document.querySelectorAll<HTMLElement>('[data-events] > li[data-date]')];
  items.filter((li) => (li.dataset.date ?? '') < iso).forEach((li) => li.remove());
  const remaining = [...document.querySelectorAll<HTMLElement>('[data-events] > li[data-date]')];
  remaining.forEach((li, i) => (li.hidden = i >= 4));

  const more = document.querySelector<HTMLButtonElement>('[data-more-events]');
  if (more && remaining.length <= 4) more.remove();
  more?.addEventListener('click', () => {
    const open = more.getAttribute('aria-expanded') !== 'true';
    more.setAttribute('aria-expanded', String(open));
    more.textContent = open ? 'Show Fewer Events' : 'View Full Event Calendar';
    remaining.forEach((li, i) => (li.hidden = !open && i >= 4));
  });
</script>

<style>
  /* ---------------------------------------------------------------- hero */
  .hero {
    position: relative;
    padding-bottom: 34px;
  }

  .hero__botanical {
    position: absolute;
    left: 0;
    top: 90px;
    width: 104px;
    height: auto;
    pointer-events: none;
  }

  .hero__copy {
    width: 720px;
    margin: 14px auto 0;
    text-align: center;
  }

  .hero__eyebrow {
    font-size: 10.5px;
    line-height: 16px;
    letter-spacing: 0.4px;
    color: #4d4529;
  }

  .hero__title {
    margin-top: 13px;
    font-family: var(--font-display);
    font-size: 54px;
    font-weight: 600;
    line-height: 54px;
    color: var(--ink);
  }

  .hero__title span {
    white-space: nowrap;
  }

  .hero__lede {
    width: 560px;
    margin: 12px auto 0;
    font-size: 14.5px;
    line-height: 20.5px;
    color: var(--ink-soft);
  }

  .hero__cta {
    height: 31px;
    margin-top: 14px;
    padding: 0 18px;
    font-size: 11px;
    letter-spacing: 1.6px;
  }

  .btn :global(svg) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------------------------------------------------------------- stores */
  .stores {
    position: relative;
    padding-bottom: 46px;
  }

  .stores__vine {
    position: absolute;
    right: 0;
    top: -2px;
    z-index: 2;
    width: 166px;
    height: auto;
    pointer-events: none;
  }

  .stores__eyebrow {
    display: flex;
    justify-content: center;
    padding-top: 10px;
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 3px;
    color: #4d4529;
  }

  .stores__eyebrow span {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .stores__eyebrow span::before,
  .stores__eyebrow span::after {
    content: '';
    width: 80px;
    height: 1px;
    background: radial-gradient(circle, #8d866c 1.6px, transparent 2px) left center / 4px 4px no-repeat,
      linear-gradient(#8d866c, #8d866c) center / 100% 1px no-repeat;
  }

  .stores__eyebrow span::after {
    background: radial-gradient(circle, #8d866c 1.6px, transparent 2px) right center / 4px 4px no-repeat,
      linear-gradient(#8d866c, #8d866c) center / 100% 1px no-repeat;
  }

  .stores__title {
    margin-top: 9px;
    font-family: var(--font-display);
    font-size: 25.5px;
    font-weight: 600;
    line-height: 32px;
    text-align: center;
    color: var(--ink);
  }

  .stores__list {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-top: 13px;
  }

  .store {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 230px;
    min-height: 118px;
    padding: 14px 16px;
    border: 1px solid rgba(160, 135, 105, 0.22);
    border-radius: 3px;
    background: rgba(255, 252, 246, 0.42);
    text-align: center;
  }

  .store__name {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 700;
    line-height: 1;
  }

  .store__tagline {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 2.4px;
    text-transform: uppercase;
  }

  .store__note {
    font-size: 11px;
    line-height: 15px;
    white-space: pre-line;
    color: var(--ink-muted);
  }

  address.store__note {
    font-style: normal;
  }

  .store__directions {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--rust);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .store__directions:hover {
    color: #7d321a;
  }

  .store__more {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 500;
    line-height: 19px;
    color: var(--ink);
  }

  .store--more .store__note {
    position: relative;
    padding-top: 10px;
  }

  .store--more .store__note::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 12px;
    height: 1px;
    background: #8d866c;
    transform: translateX(-50%);
  }

  /* ---------------------------------------------------------------- events */
  .events {
    position: relative;
    height: 228px;
    background: #ecd3be url('/images/market/pink-tile.jpg') repeat;
    scroll-margin-top: 24px;
  }

  .events::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -24px;
    height: 46px;
    background: url('/images/market/edge-pink.png') left top / auto 46px repeat-x;
    pointer-events: none;
  }

  .events__botanical {
    position: absolute;
    left: 0;
    top: 12px;
    width: 100px;
    height: auto;
    pointer-events: none;
  }

  .events .wrap {
    display: flex;
  }

  .events__intro {
    width: 274px;
    padding: 21px 0 0 110px;
    box-sizing: content-box;
  }

  .events__eyebrow {
    font-size: 10.5px;
    line-height: 14px;
    letter-spacing: 1px;
    color: #9f3e1c;
  }

  .events__title {
    margin-top: 8px;
    font-family: var(--font-display);
    font-size: 31px;
    font-weight: 600;
    line-height: 38px;
    color: var(--ink);
  }

  .events__text {
    width: 255px;
    margin-top: 6px;
    font-size: 12.5px;
    line-height: 17.5px;
    color: var(--ink-soft);
  }

  .events__more {
    height: 32px;
    margin-top: 14px;
    padding: 0 18px;
    font-size: 10.5px;
    letter-spacing: 1.6px;
    border-color: #a05a3a;
    color: #8f3d20;
  }

  .events__more:hover {
    background: var(--rust-bg);
    border-color: var(--rust-bg);
  }

  .events__list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 388px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .events__list > li[hidden] {
    display: none;
  }

  .events__soon {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    border: 1px dashed rgba(160, 110, 80, 0.45);
    border-radius: 2px;
    font-size: 12.5px;
    font-style: italic;
    color: var(--ink-muted);
  }

  .events__empty {
    width: 388px;
    margin-top: 40px;
    font-size: 14px;
    color: var(--ink-soft);
  }

  .event {
    display: flex;
    align-items: center;
    height: 44px;
    border-radius: 2px;
    background: rgba(255, 251, 245, 0.72);
    box-shadow: 0 1px 2px rgba(110, 70, 40, 0.08);
    transition: background-color 0.2s ease;
  }

  .event:hover {
    background: rgba(255, 252, 247, 0.95);
  }

  .event__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 0 0 48px;
    align-self: stretch;
    justify-content: center;
    border-right: 1px solid rgba(160, 120, 90, 0.25);
    color: #a5442a;
  }

  .event__month {
    font-family: var(--font-mono);
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .event__day {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 500;
    line-height: 18px;
  }

  .event__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-left: 16px;
  }

  .event__name {
    font-family: var(--font-subhead);
    font-size: 10.5px;
    font-weight: 700;
    color: var(--ink);
  }

  .event__meta {
    display: flex;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--ink-muted);
  }

  .event__meta > span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .event__meta svg {
    fill: none;
    stroke: #a5442a;
    stroke-width: 1.3;
    stroke-linecap: round;
  }

  .event__chevron {
    margin-right: 16px;
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .event:hover .event__chevron {
    stroke: var(--rust);
  }

  .events__polaroid {
    position: absolute;
    left: 752px;
    top: -6px;
    z-index: 3;
    width: 246px;
    height: auto;
    filter: drop-shadow(0 3px 6px rgba(60, 35, 20, 0.18));
  }

  /* ---------------------------------------------------------------- wholesale */
  main {
    display: flex;
    flex-direction: column;
  }

  /* on tall windows the green band runs down to the footer */
  .wholesale {
    flex: 1 0 auto;
    position: relative;
    z-index: 1;
    min-height: 140px;
    background: #575730 url('/images/market/green-tile.jpg') repeat;
    color: #f4efdf;
  }

  .wholesale::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -18px;
    height: 30px;
    background: url('/images/market/edge-green.png') left top / auto 30px repeat-x;
    pointer-events: none;
  }

  .wholesale__jar {
    position: absolute;
    left: 0;
    top: 6px;
    width: 126px;
    height: auto;
    pointer-events: none;
  }

  .wholesale__sprig {
    position: absolute;
    left: calc(50% + 334px);
    top: 3px;
    width: 120px;
    height: auto;
    pointer-events: none;
  }

  .wholesale .wrap {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .wholesale__copy {
    padding: 15px 0 0 141px;
  }

  .wholesale__eyebrow {
    font-size: 10.5px;
    line-height: 14px;
    letter-spacing: 1.2px;
    color: #e6e2cc;
  }

  .wholesale__title {
    margin-top: 9px;
    font-family: var(--font-display);
    font-size: 23.5px;
    font-weight: 600;
    line-height: 30px;
    color: #fbf8ee;
  }

  .wholesale__text {
    width: 345px;
    margin-top: 6px;
    font-size: 12.5px;
    line-height: 18px;
    color: #e3dfc8;
  }

  .wholesale__cta {
    height: 30px;
    margin: 45px 195px 0 0;
    padding: 0 16px;
    background: #fbf6ea;
    color: #3f3a22;
    font-size: 10.5px;
    letter-spacing: 1.6px;
    border-radius: 1px;
  }

  .wholesale__cta:hover {
    background: #fff;
  }

  /* ---------------------------------------------------------------- mobile */
  @media (max-width: 1023px) {
    .hero {
      padding-bottom: 8px;
    }

    .hero__botanical {
      display: none;
    }

    .hero__copy {
      width: auto;
      max-width: 520px;
      padding: 16px 16px 20px;
    }

    .hero__title {
      font-size: 36px;
      line-height: 40px;
    }

    .hero__lede {
      width: auto;
    }

    .stores {
      height: auto;
      padding-bottom: 48px;
    }

    .stores__vine {
      display: none;
    }

    .stores__eyebrow {
      padding-top: 20px;
    }

    .stores__title {
      padding: 0 16px;
      font-size: 24px;
    }

    .stores__list {
      flex-wrap: wrap;
      margin-top: 18px;
      padding: 0 16px;
    }


    .store {
      flex: 1 1 200px;
      max-width: 280px;
    }

    .events {
      height: auto;
      padding-bottom: 48px;
    }

    .events__botanical,
    .events__polaroid {
      display: none;
    }

    .events .wrap {
      flex-direction: column;
      align-items: center;
      padding: 0 16px;
    }

    .events__intro {
      display: contents;
    }

    .events__eyebrow {
      padding-top: 26px;
    }

    .events__text {
      width: auto;
      max-width: 420px;
      text-align: center;
    }

    .events__list,
    .events__empty {
      order: 1;
      width: 100%;
      max-width: 520px;
    }

    .events__more {
      order: 2;
      margin-top: 18px;
    }

    .event {
      height: 54px;
    }

    .event__name {
      font-size: 12px;
    }

    .event__meta {
      flex-direction: column;
      gap: 2px;
      font-size: 10px;
    }

    .wholesale {
      height: auto;
      min-height: 0;
    }

    .wholesale__jar,
    .wholesale__sprig {
      display: none;
    }

    .wholesale .wrap {
      flex-direction: column;
      align-items: center;
      padding: 24px 16px 36px;
      text-align: center;
    }

    .wholesale__copy {
      padding: 0;
    }

    .wholesale__text {
      width: auto;
      max-width: 420px;
    }

    .wholesale__cta {
      margin: 18px 0 0;
    }
  }
</style>
