---
import Page from '../layouts/Page.astro';
import Text from '../components/fundations/elements/Text.astro';
import Button from '../components/fundations/elements/Button.astro';
import Wrapper from '../components/fundations/containers/Wrapper.astro';
import Grid from '../components/fundations/containers/Grid.astro';
import { storeMapsUrl, eventParts, mapsUrl, upcoming } from '../data/markets';
import { getEvents, getProducts, getStores } from '../lib/content';

// Stores and events are edited in EmDash.
const [stores, events, products] = await Promise.all([getStores(), getEvents(), getProducts()]);
// Two jars for the pills in the headline.
const [jarA, jarB] = products.map((p) => (p.home ?? p.image)?.src).filter(Boolean) as string[];
const VISIBLE_EVENTS = 4;
const list = upcoming(events);

const pill =
  'inline-block object-cover h-10 w-16 align-middle rounded-full sm:h-12 sm:w-20 lg:h-16 lg:w-28 duration-300 ease-out hover:-rotate-6 hover:scale-110';
---

<Page title="Where to Find Us | Jamn Good" description="Find Jamn Good jam at local stores, flea markets and craft shows.">
  <section>
    <Wrapper variant="standard" class="flex flex-col gap-8 pt-48 pb-16">
      <h1 class="max-w-5xl text-5xl tracking-tighter sm:text-6xl lg:text-7xl text-foreground font-medium text-balance">
        Find us at local{' '}
        <span class="whitespace-nowrap">
          {jarA && <img src={jarA} alt="" width="300" height="250" class={pill} />} markets
        </span>{' '}
        and on the{' '}
        <span class="whitespace-nowrap">
          {jarB && <img src={jarB} alt="" width="300" height="250" class={pill} />} shelf.
        </span>
      </h1>
      <Text tag="p" variant="textLG" class="max-w-xl text-muted-foreground text-pretty">
        From local grocery stores to flea markets and craft shows, we love getting our jams into the community. Here’s
        where you can find us next!
      </Text>
    </Wrapper>
  </section>

  <section id="events" aria-labelledby="events-title">
    <Wrapper variant="standard" class="py-16">
      <Grid class="gap-y-12">
        <div class="flex flex-col col-span-12 gap-4 lg:col-span-4">
          <Text id="events-title" tag="h2" variant="displaySM" class="tracking-tight text-foreground font-medium">
            Upcoming events
          </Text>
          <Text tag="p" variant="textBase" class="text-muted-foreground text-pretty">
            We love meeting new faces and being part of local markets, craft shows, and community events. Come say hi!
          </Text>
        </div>
        <div class="flex flex-col col-span-12 gap-6 lg:col-span-8">
          {
            list.length > 0 ? (
              <ol class="flex flex-col gap-3" data-events>
                {list.map((e, i) => {
                  const { month, day } = eventParts(e);
                  return (
                    <li data-date={e.date} hidden={i >= VISIBLE_EVENTS}>
                      <a
                        class="flex items-center gap-6 p-4 duration-300 ease-out rounded-xl bg-muted hover:bg-border group"
                        href={mapsUrl(e)}
                        target="_blank"
                        rel="noopener"
                      >
                        <span class="flex flex-col items-center justify-center rounded-md shrink-0 size-16 bg-background">
                          <span class="text-xs text-muted-foreground">{month}</span>
                          <span class="text-2xl font-medium tracking-tight tabular-nums">{day}</span>
                        </span>
                        <span class="flex flex-col flex-1 gap-1">
                          <span class="text-lg font-medium tracking-tight">{e.name}</span>
                          <span class="text-sm text-muted-foreground">
                            {e.town},{' '}
                            {e.start && e.end ? `${e.start} to ${e.end}` : (e.start ?? e.end ?? 'times to be announced')}
                          </span>
                        </span>
                        <span class="flex items-center justify-center mr-2 text-xs duration-200 rounded-full size-5 bg-foreground text-background group-hover:translate-x-0.5" aria-hidden="true">
                          &rarr;
                        </span>
                        <span class="sr-only">(opens map in a new tab)</span>
                      </a>
                    </li>
                  );
                })}
              </ol>
            ) : (
              <p class="p-8 rounded-xl bg-muted text-muted-foreground">New dates coming soon. Check back shortly!</p>
            )
          }
          {list.length > 0 && list.length < VISIBLE_EVENTS && <Text tag="p" variant="textSM" class="text-muted-foreground">More dates coming soon. Check back often!</Text>}
          {
            list.length > VISIBLE_EVENTS && (
              <Button variant="muted" size="sm" class="w-fit" data-more-events aria-expanded="false">
                View all events
              </Button>
            )
          }
        </div>
      </Grid>
    </Wrapper>
  </section>

  <section aria-labelledby="stores-title">
    <Wrapper variant="standard" class="py-16">
      <Grid class="gap-y-12">
        <div class="flex flex-col col-span-12 gap-4 lg:col-span-4">
          <Text id="stores-title" tag="h2" variant="displaySM" class="tracking-tight text-foreground font-medium">
            In local stores
          </Text>
          <Text tag="p" variant="textBase" class="text-muted-foreground text-pretty">
            Look for Jamn Good on the shelf at {stores.length === 1 ? 'this location' : 'these locations'}.
          </Text>
        </div>
        <ul class="grid grid-cols-1 col-span-12 gap-6 sm:grid-cols-2 lg:col-span-8">
          {
            stores.map((s) => (
              <li class="flex flex-col justify-between gap-8 p-8 rounded-xl bg-muted">
                <div class="flex flex-col gap-1">
                  <Text tag="h3" variant="textLG" class="tracking-tight text-foreground font-medium">
                    {s.branch ? `${s.name} ${s.branch}` : s.name}
                  </Text>
                  <address class="text-sm not-italic text-muted-foreground">
                    {s.street}
                    <br />
                    {s.city}
                  </address>
                </div>
                <a
                  class="flex items-center gap-2 text-sm font-medium duration-200 w-fit text-foreground hover:text-muted-foreground"
                  href={storeMapsUrl(s)}
                  target="_blank"
                  rel="noopener"
                >
                  Get directions<span class="sr-only"> to {s.name} {s.branch} (opens map in a new tab)</span>
                </a>
              </li>
            ))
          }
          <li class="flex flex-col gap-1 p-8 rounded-xl bg-muted">
            <Text tag="h3" variant="textLG" class="tracking-tight text-foreground font-medium">More shops coming soon</Text>
            <Text tag="p" variant="textSM" class="text-muted-foreground">Check back often for new locations!</Text>
          </li>
        </ul>
      </Grid>
    </Wrapper>
  </section>

  <section aria-labelledby="wholesale-title">
    <Wrapper variant="standard" class="py-24">
      <Grid class="gap-y-8 p-8 rounded-xl bg-muted lg:p-12">
        <div class="flex flex-col col-span-12 gap-4 lg:col-span-8">
          <Text id="wholesale-title" tag="h2" variant="displaySM" class="tracking-tight text-foreground font-medium text-balance">
            Interested in carrying our jams? We’d love to work with you.
          </Text>
          <Text tag="p" variant="textBase" class="max-w-xl text-muted-foreground text-pretty">
            If you’re a local shop, market, or organization interested in carrying Jamn Good, we’d love to hear from you.
          </Text>
        </div>
        <div class="flex items-end col-span-12 lg:col-span-4 lg:justify-end">
          <Button isLink href="/contact?topic=wholesale" variant="primary" size="md">Inquire about wholesale</Button>
        </div>
      </Grid>
    </Wrapper>
  </section>
</Page>

<script>
  // Pages can be cached: drop events that have passed since they were rendered.
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York' }).format(new Date());
  const items = [...document.querySelectorAll<HTMLElement>('[data-events] > li[data-date]')];
  items.filter((li) => (li.dataset.date ?? '') < today).forEach((li) => li.remove());
  const remaining = [...document.querySelectorAll<HTMLElement>('[data-events] > li[data-date]')];
  remaining.forEach((li, i) => (li.hidden = i >= 4));
  const more = document.querySelector<HTMLButtonElement>('[data-more-events]');
  if (more && remaining.length <= 4) more.remove();
  more?.addEventListener('click', () => {
    const open = more.getAttribute('aria-expanded') !== 'true';
    more.setAttribute('aria-expanded', String(open));
    more.textContent = open ? 'Show fewer events' : 'View all events';
    remaining.forEach((li, i) => (li.hidden = !open && i >= 4));
  });
</script>
