---
import Page from '../layouts/Page.astro';
import Text from '../components/fundations/elements/Text.astro';
import Button from '../components/fundations/elements/Button.astro';
import Wrapper from '../components/fundations/containers/Wrapper.astro';
import Grid from '../components/fundations/containers/Grid.astro';
import { getSiteDetails } from '../lib/content';

const site = await getSiteDetails();
const { email } = site;

const field =
  'block w-full h-11 px-4 text-base border-0 rounded-md bg-muted text-foreground placeholder:text-muted-foreground focus:ring-0 focus:outline-2 focus:outline-offset-4 focus:outline-ring';
const label = 'text-sm font-medium text-foreground';
const links = [
  { label: email, href: `mailto:${email}`, kind: 'Email' },
  site.instagram && { label: '@jamngood', href: site.instagram, kind: 'Instagram' },
  site.facebook && { label: 'Jamn Good', href: site.facebook, kind: 'Facebook' },
].filter((l): l is { label: string; href: string; kind: string } => Boolean(l));
---

<Page title="Contact | Jamn Good" description="Questions, special requests or wholesale enquiries: get in touch with Jamn Good.">
  <section>
    <Wrapper variant="standard" class="flex flex-col gap-8 pt-48 pb-16">
      <h1 class="max-w-5xl text-5xl tracking-tighter sm:text-6xl lg:text-7xl text-foreground font-medium text-balance">
        Let’s get in touch.
      </h1>
      <Text tag="p" variant="textLG" class="max-w-xl text-muted-foreground text-pretty">
        Have a question, special request, or interested in a wholesale opportunity? We’d love to hear from you!
      </Text>
    </Wrapper>
  </section>

  <section>
    <Wrapper variant="standard" class="pb-24">
      <Grid class="gap-y-12">
        <form class="flex flex-col col-span-12 gap-6 lg:col-span-6" data-contact-form data-email={email}>
          <div class="flex flex-col gap-2">
            <label for="c-name" class={label}>Name</label>
            <input id="c-name" name="name" type="text" autocomplete="name" required class={field} />
          </div>
          <div class="flex flex-col gap-2">
            <label for="c-email" class={label}>Email</label>
            <input id="c-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required class={field} />
          </div>
          <div class="flex flex-col gap-2">
            <label for="c-message" class={label}>Message</label>
            <textarea
              id="c-message"
              name="message"
              rows="6"
              required
              class="block w-full px-4 py-3 text-base border-0 rounded-md resize-none bg-muted text-foreground placeholder:text-muted-foreground focus:ring-0 focus:outline-2 focus:outline-offset-4 focus:outline-ring"
            ></textarea>
          </div>
          <Button type="submit" variant="primary" size="md" class="w-fit">Send message</Button>
          <p class="text-sm text-muted-foreground" role="status" data-status></p>
        </form>
        <div class="flex flex-col items-center justify-between col-span-12 gap-10 p-8 rounded-xl bg-muted lg:col-span-6">
          <img src="/images/logo.webp" alt="" width="640" height="469" loading="lazy" class="w-full my-auto max-w-80" />
          <ul class="grid w-full grid-cols-1 gap-6 sm:grid-cols-3">
            {
              links.map((l) => (
                <li class="flex flex-col gap-1">
                  <span class="text-sm text-muted-foreground">{l.kind}</span>
                  <a
                    href={l.href}
                    class="text-sm font-medium break-words duration-200 text-foreground hover:text-muted-foreground"
                    {...(l.href.startsWith('http') && { target: '_blank', rel: 'noopener' })}
                  >
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </Grid>
    </Wrapper>
  </section>
</Page>

<script>
  // Arriving from a "wholesale" or "events" button: start the message for them.
  const starters: Record<string, string> = {
    wholesale: "Hi! I'm interested in carrying Jamn Good at my shop. ",
    events: "Hi! I'd love to order treats for an event.\n\nEvent date: \nNumber of guests: \nWhat I'm looking for: ",
  };
  const starter = starters[new URLSearchParams(location.search).get('topic') ?? ''];
  const msg = document.querySelector<HTMLTextAreaElement>('#c-message');
  if (starter && msg && !msg.value) msg.value = starter;

  // No backend yet: hand the message to the visitor's email app, pre-filled.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') || '');
    const subject = encodeURIComponent(`Message from ${name || 'the website'}`);
    const body = encodeURIComponent(`${data.get('message') || ''}\n\n— ${name} (${data.get('email') || ''})`);
    window.location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${body}`;
    const status = form.querySelector('[data-status]');
    if (status) status.textContent = 'Opening your email app… thanks for reaching out!';
  });
</script>
