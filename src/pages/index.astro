---
import Page from '../layouts/Page.astro';
import Hero from '../components/Hero.astro';
import Products from '../components/Products.astro';
import Story from '../components/Story.astro';
import Features from '../components/Features.astro';
import Treats from '../components/Treats.astro';
import FindUs from '../components/FindUs.astro';
import Closing from '../components/Closing.astro';
import Newsletter from '../components/Newsletter.astro';
import { getSiteDetails } from '../lib/content';

// Tells search engines who the business is (name, logo, location, social profiles).
const site = await getSiteDetails();
const origin = (Astro.site ?? Astro.url).origin;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Jamn Good',
    url: `${origin}/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Jamn Good',
    legalName: 'Jamn Good LLC',
    url: `${origin}/`,
    logo: `${origin}/images/logo-badge.png`,
    email: site.email,
    description: 'Small batch homemade jams made with real fruit, simple ingredients, and a whole lotta love.',
    address: { '@type': 'PostalAddress', addressLocality: 'Youngstown', addressRegion: 'OH', postalCode: '44515', addressCountry: 'US' },
    sameAs: [site.instagram, site.facebook].filter(Boolean),
  },
];
---

<Page jsonLd={jsonLd}>
  <Hero />
  <Products />
  <Story />
  <Features />
  <Treats />
  <FindUs />
  <Closing />
  <Newsletter />
</Page>
