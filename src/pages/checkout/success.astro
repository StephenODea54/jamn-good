---
import Page from '../../layouts/Page.astro';
import Text from '../../components/fundations/elements/Text.astro';
import Button from '../../components/fundations/elements/Button.astro';
import Wrapper from '../../components/fundations/containers/Wrapper.astro';
import Grid from '../../components/fundations/containers/Grid.astro';
import { formatPrice } from '../../data/products';
import { getSiteDetails } from '../../lib/content';
import { orderRef as toOrderRef, recordOrder } from '../../lib/orders';
import { getStripe } from '../../lib/stripe';

// Stripe sends the customer here with ?session_id=... after paying. The order is read back from
// Stripe, so this page can't be faked by editing the URL.
const sessionId = Astro.url.searchParams.get('session_id') ?? '';
const stripe = getStripe();
if (!stripe || !/^cs_[A-Za-z0-9_]+$/.test(sessionId)) return Astro.redirect('/shop');

let session;
try {
  session = await stripe.checkout.sessions.retrieve(sessionId, { expand: ['line_items'] });
} catch {
  return Astro.redirect('/shop');
}
if (session.status !== 'complete') return Astro.redirect('/shop?cart=open');

// Save the order to the CMS in case the Stripe webhook hasn't (or isn't set up). Never block the page on it.
try {
  await recordOrder(session);
} catch (error) {
  console.error('[checkout/success]', error instanceof Error ? error.message : error);
}

const site = await getSiteDetails();
const cents = (n: number | null | undefined) => formatPrice((n ?? 0) / 100);
const items = session.line_items?.data ?? [];
const firstName = (session.customer_details?.individual_name ?? session.customer_details?.name)?.split(' ')[0];
const orderRef = toOrderRef(sessionId);
---

<Page title="Thank you! | Jamn Good" description="Your Jamn Good order is confirmed." noindex>
  <section>
    <Wrapper variant="standard" class="flex flex-col gap-8 pt-48 pb-16">
      <Text tag="p" variant="textSM" class="text-muted-foreground">Order confirmed</Text>
      <h1 class="max-w-5xl text-5xl tracking-tighter sm:text-6xl lg:text-7xl text-foreground font-medium text-balance">
        Thank you{firstName ? `, ${firstName}` : ''}!
      </h1>
      <Text tag="p" variant="textLG" class="max-w-xl text-muted-foreground text-pretty">
        {site.pickupInstructions ?? 'We’ll be in touch soon to set up a pickup time.'}
      </Text>
    </Wrapper>
  </section>

  <section>
    <Wrapper variant="standard" class="pb-24">
      <Grid class="gap-y-8">
        <div class="flex flex-col col-span-12 gap-6 p-8 rounded-xl bg-muted lg:col-span-7">
          <p class="text-sm text-muted-foreground">Order <span class="font-medium text-foreground">#{orderRef}</span></p>
          <ul class="flex flex-col gap-3">
            {
              items.map((li) => (
                <li class="flex justify-between gap-6">
                  <span>
                    {li.description} <span class="text-muted-foreground">× {li.quantity}</span>
                  </span>
                  <span class="tabular-nums">{cents(li.amount_subtotal)}</span>
                </li>
              ))
            }
          </ul>
          <dl class="flex justify-between gap-6 pt-6 text-lg font-medium tracking-tight">
            <dt>Total paid</dt>
            <dd class="tabular-nums">{cents(session.amount_total)}</dd>
          </dl>
        </div>
        <div class="flex flex-col justify-between col-span-12 gap-8 lg:col-span-5">
          <div class="flex flex-col gap-3 text-sm text-muted-foreground">
            {session.customer_details?.email && <p>A receipt is on its way to {session.customer_details.email}.</p>}
            <p>
              Questions about your order? Email{' '}
              <a href={`mailto:${site.email}`} class="font-medium duration-200 text-foreground hover:text-muted-foreground">
                {site.email}
              </a>{' '}
              and mention order #{orderRef}.
            </p>
          </div>
          <Button isLink href="/shop" variant="primary" size="md" class="w-fit">Keep shopping</Button>
        </div>
      </Grid>
    </Wrapper>
  </section>
</Page>

<script>
  import { clearCart } from '../../scripts/cart';
  clearCart();
  document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((el) => (el.hidden = true));
</script>
