---
import Page from '../../layouts/Page.astro';
import Newsletter from '../../components/Newsletter.astro';
import Text from '../../components/fundations/elements/Text.astro';
import Wrapper from '../../components/fundations/containers/Wrapper.astro';
import { formatIssueDate, getNewsletters } from '../../lib/content';

// Issues are written in EmDash under Newsletters.
const issues = await getNewsletters();
---

<Page title="Newsletter | Jamn Good" description="News from Jamn Good: new flavors, markets, and all things jam.">
  <section>
    <Wrapper variant="standard" class="flex flex-col gap-8 pt-48 pb-16">
      <h1 class="max-w-5xl text-5xl tracking-tighter sm:text-6xl lg:text-7xl text-foreground font-medium text-balance">
        Stay in the loop.
      </h1>
      <Text tag="p" variant="textLG" class="max-w-xl text-muted-foreground text-pretty">
        New flavors, markets, and all things Jamn Good.
      </Text>
    </Wrapper>
  </section>

  <section>
    <Wrapper variant="standard">
      {
        issues.length > 0 ? (
          <ol class="flex flex-col gap-3">
            {issues.map((n) => (
              <li>
                <a
                  href={`/newsletter/${n.slug}`}
                  class="flex flex-col gap-1 p-6 duration-300 ease-out rounded-xl bg-muted hover:bg-border"
                >
                  <span class="text-sm text-muted-foreground">{formatIssueDate(n.publishedAt)}</span>
                  <span class="text-lg font-medium tracking-tight text-foreground">{n.title}</span>
                  {n.preview && <span class="text-sm text-muted-foreground text-pretty">{n.preview}</span>}
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <p class="p-8 rounded-xl bg-muted text-muted-foreground">
            Our first newsletter is on its way. Sign up below so you don’t miss it!
          </p>
        )
      }
    </Wrapper>
  </section>

  <Newsletter />
</Page>
