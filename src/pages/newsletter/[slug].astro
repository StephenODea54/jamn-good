---
import { PortableText } from 'emdash/ui';
import Page from '../../layouts/Page.astro';
import Newsletter from '../../components/Newsletter.astro';
import Text from '../../components/fundations/elements/Text.astro';
import Wrapper from '../../components/fundations/containers/Wrapper.astro';
import { formatIssueDate, getNewsletter } from '../../lib/content';

const issue = await getNewsletter(Astro.params.slug ?? '');
if (!issue) {
  return new Response('Not found', { status: 404 });
}
---

<Page title={`${issue.title} | Jamn Good`} description={issue.preview ?? 'News from Jamn Good.'}>
  <article>
    <Wrapper variant="standard" class="flex flex-col gap-12 pt-36 pb-8">
      <a
        href="/newsletter"
        class="flex items-center gap-2 text-sm font-medium duration-200 w-fit text-muted-foreground hover:text-foreground"
      >
        <span aria-hidden="true">&larr;</span> All newsletters
      </a>
      <header class="flex flex-col max-w-3xl gap-4">
        <Text tag="p" variant="textSM" class="text-muted-foreground">{formatIssueDate(issue.publishedAt)}</Text>
        <h1 class="text-5xl tracking-tighter sm:text-6xl text-foreground font-medium text-balance">{issue.title}</h1>
      </header>
      <div
        class="max-w-2xl prose prose-lg prose-headings:font-medium prose-headings:tracking-tight prose-a:text-foreground prose-a:no-underline prose-img:rounded-xl"
      >
        <PortableText value={issue.body} />
      </div>
    </Wrapper>
  </article>

  <Newsletter />
</Page>
