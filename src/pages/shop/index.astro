---
import Page from '../../layouts/Page.astro';
import ProductCard from '../../components/ProductCard.astro';
import { categories } from '../../data/products';
import { getProducts } from '../../lib/content';

const products = await getProducts();
---

<Page title="Shop | Jamn Good" description="Small batch homemade jams made with real fruit and simple ingredients.">
  <section class="shop">
    <img class="shop__botanical" src="/images/shop-botanical.png" alt="" width="205" height="290" />

    <div class="wrap">
      <header class="page-head shop__head">
        <p class="page-head__eyebrow eyebrow">Our Jams</p>
        <h1 class="page-head__title">Small batch. Big flavor.</h1>
        <p class="page-head__lede">Made with real fruit, simple ingredients, and a whole lotta love.</p>
        <img class="ornament" src="/images/ornament.png" alt="" width="120" height="24" />
      </header>

      <div class="tabs" role="group" aria-label="Filter jams">
        {
          categories.map((c, i) => (
            <button type="button" class="tabs__tab" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={c.id}>
              {c.label}
            </button>
          ))
        }
      </div>

      <div class="shop__grid" data-grid>
        {products.map((p) => <ProductCard product={p} />)}
      </div>
      <p class="shop__empty" data-empty hidden>No jams in this category right now — check back soon!</p>
    </div>
  </section>
</Page>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-grid] [data-category]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      const filter = tab.dataset.filter;
      tabs.forEach((t) => t.setAttribute('aria-pressed', String(t === tab)));
      let shown = 0;
      cards.forEach((card) => {
        const match = filter === 'all' || card.dataset.category === filter;
        card.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    }),
  );
</script>

<style>
  .shop {
    position: relative;
    padding-bottom: 88px;
  }

  .shop__botanical {
    position: absolute;
    left: 0;
    top: -82px;
    width: 176px;
    height: auto;
    pointer-events: none;
  }

  .shop__head {
    padding-top: 22px;
  }

  .tabs {
    display: flex;
    justify-content: space-between;
    width: 520px;
    height: 42px;
    margin: 34px auto 0;
    padding: 3px;
    border: 1px solid rgba(150, 125, 95, 0.4);
    border-radius: 21px;
    background: rgba(255, 252, 245, 0.35);
  }

  .tabs__tab {
    flex: 1;
    border: 0;
    border-radius: 18px;
    background: none;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: #5b4e3f;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .tabs__tab:first-child {
    flex: 0 0 88px;
  }

  .tabs__tab:hover {
    color: var(--rust);
  }

  .tabs__tab[aria-pressed='true'] {
    background: var(--rust-bg);
    color: var(--cream);
  }

  /* flex rather than grid so a short last row sits centred */
  .shop__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 46px 33px;
    max-width: 966px;
    margin: 44px auto 0;
  }

  .shop__grid > :global(*) {
    flex: 0 0 300px;
  }

  .shop__grid > :global([hidden]) {
    display: none;
  }

  .shop__empty {
    margin-top: 40px;
    text-align: center;
    color: var(--ink-soft);
  }

  @media (max-width: 1023px) {
    .shop__botanical {
      display: none;
    }

    .shop__head {
      padding: 28px 16px 0;
    }

    .tabs {
      width: auto;
      max-width: 520px;
      margin: 28px max(16px, calc(50% - 260px)) 0;
    }

    .tabs__tab {
      font-size: 10.5px;
      letter-spacing: 1px;
    }

    .tabs__tab:first-child {
      flex-basis: 64px;
    }

    .shop__grid {
      gap: 36px 20px;
      padding: 0 16px;
    }

    .shop__grid > :global(*) {
      flex-basis: min(300px, calc(50% - 10px));
    }
  }

  @media (max-width: 560px) {
    .shop__grid > :global(*) {
      flex-basis: min(340px, 100%);
    }
  }
</style>
