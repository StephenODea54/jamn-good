---
import Page from '../../layouts/Page.astro';
import ProductCard from '../../components/ProductCard.astro';
import Text from '../../components/fundations/elements/Text.astro';
import Wrapper from '../../components/fundations/containers/Wrapper.astro';
import Grid from '../../components/fundations/containers/Grid.astro';
import { shopTabs } from '../../data/products';
import { getProducts } from '../../lib/content';

const products = await getProducts();
---

<Page title="Shop | Jamn Good" description="Small batch homemade jams made with real fruit and simple ingredients.">
  <section>
    <Wrapper variant="standard" class="flex flex-col gap-8 pt-48 pb-16">
      <h1 class="max-w-5xl text-5xl tracking-tighter sm:text-6xl lg:text-7xl text-foreground font-medium text-balance">
        Small batch. Big flavor.
      </h1>
      <Text tag="p" variant="textLG" class="max-w-xl text-muted-foreground text-pretty">
        Made with real fruit, simple ingredients, and a whole lotta love. Order online for local pickup.
      </Text>
    </Wrapper>
  </section>

  <section>
    <Wrapper variant="standard" class="flex flex-col gap-12 pb-24">
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter products">
        {
          shopTabs.map((c, i) => (
            <button
              type="button"
              aria-pressed={i === 0 ? 'true' : 'false'}
              data-filter={c.id}
              class="flex items-center h-9 px-4 text-sm font-medium duration-300 ease-out rounded-md cursor-pointer bg-muted text-foreground hover:bg-border aria-pressed:bg-foreground aria-pressed:text-background focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
            >
              {c.label}
            </button>
          ))
        }
      </div>
      <Grid class="gap-y-12" data-grid>
        {
          products.map((p, i) => (
            <div class="col-span-12 sm:col-span-6 lg:col-span-4 [&:has(>[hidden])]:hidden">
              <ProductCard product={p} eager={i < 3} />
            </div>
          ))
        }
      </Grid>
      <p class="text-muted-foreground" data-empty hidden>Nothing here right now. Check back soon!</p>
    </Wrapper>
  </section>
</Page>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-grid] [data-kind]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      const filter = tab.dataset.filter;
      tabs.forEach((t) => t.setAttribute('aria-pressed', String(t === tab)));
      let shown = 0;
      cards.forEach((card) => {
        const match =
          filter === 'all' ||
          (filter === 'limited' ? card.dataset.limited === 'true' : card.dataset.kind === filter);
        card.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    }),
  );
</script>
