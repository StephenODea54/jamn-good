---
import Page from '../../layouts/Page.astro';
import ProductCard from '../../components/ProductCard.astro';
import StockBadge from '../../components/StockBadge.astro';
import Text from '../../components/fundations/elements/Text.astro';
import Button from '../../components/fundations/elements/Button.astro';
import Wrapper from '../../components/fundations/containers/Wrapper.astro';
import Grid from '../../components/fundations/containers/Grid.astro';
import { formatPrice } from '../../data/products';
import { getProduct, getProducts } from '../../lib/content';

const product = await getProduct(Astro.params.slug ?? '');
if (!product) {
  return new Response('Not found', { status: 404 });
}

// "You might also like": the next three products of the same type, in shop order.
const products = await getProducts();
const at = products.findIndex((p) => p.slug === product.slug);
const ordered = [...products.slice(at + 1), ...products.slice(0, Math.max(at, 0))];
const related = [
  ...ordered.filter((p) => p.kind === product.kind),
  ...ordered.filter((p) => p.kind !== product.kind),
].slice(0, 3);

const hero = product.hero ?? product.image;
const { rating } = product;
const facts = [
  { label: 'Ingredients', text: product.ingredients },
  { label: 'Storage and shelf life', text: product.storage },
].filter((f): f is { label: string; text: string } => Boolean(f.text));

// Product details for search results (price and whether it's in stock).
const origin = (Astro.site ?? Astro.url).origin;
const pageUrl = new URL(Astro.url.pathname, origin).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  sku: product.slug,
  brand: { '@type': 'Brand', name: 'Jamn Good' },
  ...(hero && { image: [new URL(hero.src, origin).href] }),
  offers: {
    '@type': 'Offer',
    url: pageUrl,
    price: product.price.toFixed(2),
    priceCurrency: 'USD',
    availability: product.outOfStock ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
  },
};

---

<Page title={`${product.name} | Jamn Good`} description={product.description} image={product.image?.src} jsonLd={jsonLd}>
  <section>
    <Wrapper variant="standard" class="flex flex-col gap-10 pt-36 pb-24">
      <a href="/shop" class="flex items-center gap-2 text-sm font-medium duration-200 w-fit text-muted-foreground hover:text-foreground">
        <span aria-hidden="true">&larr;</span> Back to shop
      </a>
      <Grid class="gap-y-12" data-product>
        <div class="flex flex-col col-span-12 gap-6 lg:col-span-7">
          <div class="relative overflow-hidden rounded-xl bg-muted">
            {hero && <img src={hero.src} alt={hero.alt} width={hero.width ?? 982} height={hero.height ?? 1140} class:list={['object-cover w-full aspect-square', { 'opacity-60': product.outOfStock }]} />}
            {product.outOfStock && <StockBadge />}
          </div>
          {
            product.gallery.length > 0 && (
              <ul class="grid grid-cols-3 gap-6">
                {product.gallery.map((g) => (
                  <li class="overflow-hidden rounded-xl bg-muted">
                    <img src={g.src} alt="" width="300" height="300" loading="lazy" class="object-cover w-full aspect-square" />
                  </li>
                ))}
              </ul>
            )
          }
        </div>
        <div class="flex flex-col col-span-12 gap-10 lg:col-span-5">
          <div class="flex flex-col gap-4">
            <h1 class="text-5xl tracking-tighter sm:text-6xl text-foreground font-medium text-balance">{product.name}</h1>
            <Text tag="p" variant="displayXS" class="tracking-tight text-foreground tabular-nums">
              {product.note ? `${formatPrice(product.price)} ${product.note}` : formatPrice(product.price)}
            </Text>
            {
              rating !== undefined && (
                <p class="flex items-center gap-2 text-sm text-muted-foreground">
                  <span class="flex gap-0.5 text-foreground" aria-hidden="true">
                    {Array.from({ length: 5 }, (_, i) => (
                      <svg viewBox="0 0 20 19" width="16" height="15" fill="currentColor" class:list={{ 'opacity-20': i >= rating }}>
                        <path d="m10 1 2.6 5.9 6.4.6-4.8 4.3 1.4 6.3L10 14.8l-5.6 3.3 1.4-6.3L1 7.5l6.4-.6Z" />
                      </svg>
                    ))}
                  </span>
                  <span class="sr-only">Rated {rating} out of 5,</span>
                  {product.reviews !== undefined && <span>({product.reviews} reviews)</span>}
                </p>
              )
            }
          </div>
          <Text tag="p" variant="textLG" class="text-muted-foreground text-pretty">{product.description}</Text>
          {
            product.outOfStock ? (
              <div class="flex flex-col gap-4">
                <Text tag="p" variant="textBase" class="text-foreground">Sold out for now. Check back soon!</Text>
                <Button variant="primary" size="md" class="w-fit" disabled>Sold out</Button>
              </div>
            ) : (
              <div class="flex flex-wrap gap-3">
                <div class="h-11 qty" data-qty>
                  <button type="button" aria-label="Decrease quantity" data-qty-dec>−</button>
                  <input type="number" inputmode="numeric" min="1" max="99" value="1" aria-label="Quantity" data-qty-input />
                  <button type="button" aria-label="Increase quantity" data-qty-inc>+</button>
                </div>
                <Button variant="primary" size="md" data-add-to-cart={product.slug}>Add to cart</Button>
              </div>
            )
          }
          {
            facts.length > 0 && (
              <dl class="flex flex-col gap-6 p-8 rounded-xl bg-muted">
                {facts.map((f) => (
                  <div class="flex flex-col gap-1">
                    <dt class="text-sm font-medium text-foreground">{f.label}</dt>
                    <dd class="text-sm text-muted-foreground text-pretty">{f.text}</dd>
                  </div>
                ))}
              </dl>
            )
          }
          <Text tag="p" variant="textSM" class="text-muted-foreground">Local pickup only. We’ll reach out after you order to set up a time.</Text>
        </div>
      </Grid>
    </Wrapper>
  </section>

  <section aria-labelledby="related-title">
    <Wrapper variant="standard" class="py-24">
      <Text id="related-title" tag="h2" variant="displaySM" class="tracking-tight text-foreground font-medium">You might also like</Text>
      <Grid tag="ul" class="mt-12 gap-y-12">
        {related.map((p) => <li class="col-span-12 sm:col-span-6 lg:col-span-4"><ProductCard product={p} /></li>)}
      </Grid>
    </Wrapper>
  </section>
</Page>

<script>
  import { initQtySteppers } from '../../scripts/cart';
  initQtySteppers();
</script>
