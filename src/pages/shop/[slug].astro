---
import Page from '../../layouts/Page.astro';
import ProductCard from '../../components/ProductCard.astro';
import { formatPrice } from '../../data/products';
import { getProduct, getProducts } from '../../lib/content';

const product = await getProduct(Astro.params.slug ?? '');
if (!product) {
  return new Response('Not found', { status: 404 });
}

// "You might also like": the next three products of the same type, in shop order.
const products = await getProducts();
const at = products.findIndex((p) => p.slug === product.slug);
const ordered = [...products.slice(at + 1), ...products.slice(0, Math.max(at, 0))];
const related = [
  ...ordered.filter((p) => p.kind === product.kind),
  ...ordered.filter((p) => p.kind !== product.kind),
].slice(0, 3);

const hero = product.hero ?? product.image;
const { rating } = product;
const facts = [
  { label: 'Ingredients', text: product.ingredients },
  { label: 'Storage &amp; Shelf Life', text: product.storage },
].filter((f): f is { label: string; text: string } => Boolean(f.text));
const tall = Boolean(product.hero);

---

<Page title={`${product.name} | Jamn Good`} description={product.description}>
  <div class="wrap pd">
    <a href="/shop" class="pd__back">
      <svg viewBox="0 0 22 12" width="22" height="12" aria-hidden="true"><path d="M21 6H2M7 1 2 6l5 5" /></svg>
      Back to Shop
    </a>

    <div class="pd__main" data-product>
      <div class="pd__gallery">
        <div class:list={['pd__photo', { 'pd__photo--tall': tall }]}>
          {hero && <img src={hero.src} alt={hero.alt} width="491" height={tall ? 570 : 481} />}
        </div>
        {
          product.gallery.length > 0 && (
            <ul class="pd__thumbs">
              {product.gallery.map((g) => (
                <li>
                  <img src={g.src} alt="" width="153" height="140" loading="lazy" />
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="pd__info">
        <h1 class="pd__title">{product.name}</h1>
        <p class="pd__price">{formatPrice(product.price)}</p>
        {product.note && <p class="pd__note">{product.note}</p>}

        {
          rating !== undefined && (
            <p class="pd__rating">
              <span class="pd__stars" aria-hidden="true">
                {Array.from({ length: 5 }, (_, i) => (
                  <svg viewBox="0 0 20 19" width="16" height="15" class:list={{ 'is-off': i >= rating }}>
                    <path d="m10 1 2.6 5.9 6.4.6-4.8 4.3 1.4 6.3L10 14.8l-5.6 3.3 1.4-6.3L1 7.5l6.4-.6Z" />
                  </svg>
                ))}
              </span>
              <span class="visually-hidden">Rated {rating} out of 5,</span>
              {product.reviews !== undefined && <span class="pd__reviews">({product.reviews} reviews)</span>}
            </p>
          )
        }

        <p class="pd__desc">{product.description}</p>

        <div class="qty pd__qty" data-qty>
          <button type="button" aria-label="Decrease quantity" data-qty-dec>−</button>
          <input type="number" inputmode="numeric" min="1" max="99" value="1" aria-label="Quantity" data-qty-input />
          <button type="button" aria-label="Increase quantity" data-qty-inc>+</button>
        </div>

        <button type="button" class="btn btn--olive pd__add" data-add-to-cart={product.slug}>Add to Cart</button>
      </div>
    </div>

    {
      facts.length > 0 && (
        <dl class:list={['pd__facts', { 'pd__facts--single': facts.length === 1 }]}>
          {facts.map((f) => (
            <div>
              <dt set:html={f.label} />
              <dd>{f.text}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <section class="pd__related" aria-labelledby="related-title">
      <h2 id="related-title" class="pd__related-title">You might also like</h2>
      <div class="pd__related-grid">
        {related.map((p) => <ProductCard product={p} />)}
      </div>
    </section>
  </div>
</Page>

<script>
  import { initQtySteppers } from '../../scripts/cart';
  initQtySteppers();
</script>

<style>
  .pd {
    padding-bottom: 64px;
  }

  .pd__back {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 8px 0 0 39px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.5px;
    color: #5b4e3f;
  }

  .pd__back svg {
    fill: none;
    stroke: var(--rust);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pd__back:hover {
    color: var(--rust);
  }

  .pd__main {
    display: grid;
    grid-template-columns: 491px 431px;
    justify-content: space-between;
    margin: 26px 31px 0 34px;
  }

  .pd__photo {
    aspect-ratio: 300 / 294;
    overflow: hidden;
    border-radius: 2px;
    box-shadow: 0 2px 8px rgba(60, 40, 20, 0.16);
  }

  .pd__photo--tall {
    aspect-ratio: 491 / 570;
  }

  .pd__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pd__thumbs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-top: 22px;
  }

  .pd__thumbs img {
    width: 100%;
    height: auto;
    aspect-ratio: 153 / 140;
    object-fit: cover;
    border-radius: 2px;
    box-shadow: 0 1px 4px rgba(60, 40, 20, 0.14);
  }

  .pd__info {
    padding-top: 42px;
  }

  .pd__title {
    font-family: var(--font-display);
    font-size: 42px;
    font-weight: 600;
    line-height: 1.1;
    color: var(--ink);
  }

  .pd__price {
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 19px;
    font-weight: 600;
    color: #923b1f;
  }

  .pd__note {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: #923b1f;
  }

  .pd__rating {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 22px;
  }

  .pd__stars {
    display: flex;
    gap: 3px;
  }

  .pd__stars svg {
    fill: #b4532f;
  }

  .pd__stars svg.is-off {
    fill: #d8cbb8;
  }

  .pd__reviews {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-muted);
  }

  .pd__desc {
    margin-top: 24px;
    font-size: 16px;
    line-height: 1.75;
    color: var(--ink-soft);
  }

  .pd__qty {
    margin-top: 30px;
  }

  .pd__add {
    display: flex;
    width: 100%;
    height: 54px;
    margin-top: 14px;
    font-size: 13px;
    letter-spacing: 2.4px;
  }

  .pd__facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 64px 31px 0 34px;
    border-block: 1px solid rgba(150, 125, 95, 0.3);
  }

  .pd__facts--single {
    grid-template-columns: 1fr;
  }

  .pd__facts > div {
    padding: 28px 26px 30px;
  }

  .pd__facts > div + div {
    border-left: 1px solid rgba(150, 125, 95, 0.3);
    padding-left: 44px;
  }

  .pd__facts dt {
    font-family: var(--font-subhead);
    font-size: 15px;
    font-weight: 700;
    color: #9f3e1c;
  }

  .pd__facts dd {
    margin: 12px 0 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .pd__related {
    margin-top: 56px;
  }

  .pd__related-title {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 600;
    text-align: center;
    color: var(--ink);
  }

  .pd__related-grid {
    display: grid;
    grid-template-columns: repeat(3, 300px);
    justify-content: space-between;
    margin: 30px 31px 0 34px;
  }

  @media (max-width: 1023px) {
    .pd {
      padding: 0 16px 48px;
    }

    .pd__back {
      margin: 18px 0 0;
    }

    .pd__main {
      grid-template-columns: 1fr;
      gap: 24px;
      margin: 18px 0 0;
    }

    .pd__gallery {
      max-width: 520px;
      width: 100%;
      margin: 0 auto;
    }

    .pd__thumbs {
      gap: 10px;
      margin-top: 12px;
    }

    .pd__info {
      max-width: 520px;
      width: 100%;
      margin: 0 auto;
      padding-top: 0;
    }

    .pd__title {
      font-size: 32px;
    }

    .pd__facts {
      grid-template-columns: 1fr;
      margin: 40px 0 0;
    }

    .pd__facts > div,
    .pd__facts > div + div {
      padding: 22px 4px;
      border-left: 0;
    }

    .pd__facts > div + div {
      border-top: 1px solid rgba(150, 125, 95, 0.3);
    }

    .pd__related-title {
      font-size: 26px;
    }

    .pd__related-grid {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
      gap: 32px 20px;
      margin: 24px 0 0;
    }
  }
</style>
