---
import { PortableText } from 'emdash/ui';
import Page from '../layouts/Page.astro';
import Text from '../components/fundations/elements/Text.astro';
import TextLink from '../components/fundations/elements/TextLink.astro';
import Wrapper from '../components/fundations/containers/Wrapper.astro';
import Grid from '../components/fundations/containers/Grid.astro';
import { getFaqs } from '../lib/content';

// Questions and answers are edited in EmDash under FAQs.
const faqs = await getFaqs();
---

<Page title="FAQ | Jamn Good" description="Answers to common questions about Jamn Good jams.">
  <section>
    <Wrapper variant="standard" class="flex flex-col gap-8 pt-48 pb-16">
      <h1 class="max-w-5xl text-5xl tracking-tighter sm:text-6xl lg:text-7xl text-foreground font-medium text-balance">
        Common questions.
      </h1>
    </Wrapper>
  </section>

  <section>
    <Wrapper variant="standard" class="pb-24">
      <Grid class="gap-y-12">
        <div class="flex flex-col col-span-12 gap-6 lg:col-span-4">
          <Text tag="p" variant="textBase" class="max-w-sm text-muted-foreground text-pretty">
            Still have a question? We’re happy to help.
          </Text>
          <TextLink href="/contact">Get in touch</TextLink>
        </div>
        <div class="flex flex-col col-span-12 gap-3 lg:col-span-8">
          {
            faqs.map((f) => (
              <details class="rounded-xl bg-muted group" name="faq">
                <summary class="flex items-center justify-between gap-6 p-6 text-lg font-medium tracking-tight list-none cursor-pointer [&::-webkit-details-marker]:hidden">
                  <span>{f.question}</span>
                  <span
                    aria-hidden="true"
                    class="grid text-sm duration-300 ease-out rounded-full shrink-0 size-6 place-items-center bg-foreground text-background group-open:rotate-45"
                  >
                    +
                  </span>
                </summary>
                <div class="px-6 pb-6 -mt-2 prose max-w-none prose-p:text-muted-foreground prose-a:text-foreground prose-a:no-underline">
                  <PortableText value={f.answer} />
                </div>
              </details>
            ))
          }
        </div>
      </Grid>
    </Wrapper>
  </section>
</Page>
