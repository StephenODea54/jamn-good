---
import '../styles/global.css';
import CartDrawer from '../components/CartDrawer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Link-preview image (path or URL); defaults to the logo on cream */
  image?: string;
  /** schema.org structured data for search engines */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Keep this page out of search results */
  noindex?: boolean;
}

const {
  title = 'Jamn Good | Small Batch Homemade Jams',
  description = 'Small batch homemade jams made with real fruit, simple ingredients, and a whole lotta love.',
  image = '/og-image.png',
  jsonLd,
  noindex = false,
} = Astro.props;

// Link previews (Messages, Facebook, etc.) need absolute URLs on the public site.
const origin = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname, origin).href;
const imageUrl = new URL(image, origin).href;
// `<` is escaped so content can never close the script tag early.
const structuredData = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={pageUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    {structuredData && <script type="application/ld+json" set:html={structuredData} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jamn Good" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Geist: https://fonts.google.com/specimen/Geist -->
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body
    class="relative flex flex-col font-sans antialiased bg-background text-foreground min-h-svh selection:bg-foreground selection:text-background"
  >
    <slot />
    <CartDrawer />
  </body>
</html>
