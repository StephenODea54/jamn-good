---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}
---

<Base {...Astro.props}>
  <Header />
  <main class="grow">
    <slot />
  </main>
  <Footer />
</Base>
